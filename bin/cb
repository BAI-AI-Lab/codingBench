#!/bin/bash
# cb: run code benchmarks against an OpenAI-compatible model.
#
#   export MODEL=<model name on the endpoint> OPENAI_BASE_URL=https://.../v1 OPENAI_API_KEY=sk-...
#   cb all                 # bigcodebench livecodebench cruxeval
#   cb bigcodebench cruxeval
#   cb all --smoke         # 5 problems each, to check the endpoint and the pipeline first
#   cb summary             # scores of every finished run (LiveCodeBench: LCB's own judge and the re-judged score)
#   cb post <run dir>      # every post-processing step of a LiveCodeBench run (rejudge, usage, quality, perf); cb livecodebench
#                          # runs it by itself at the end (CB_POST=0 skips it)
#   cb progress <run dir>  # a LiveCodeBench run while it goes: answered / errors / every request in flight with its time and
#                          # the thinking and answer received so far (--watch 30 refreshes, --text shows the latest text)
#   cb report <run dir>    # Markdown report of a LiveCodeBench run (by difficulty / platform / month / failure);
#                          # a relative <run dir> is taken from runs/, e.g. cb report <model>/livecodebench-full
#   cb usage <run dir>     # latency, first-token times, speed, tokens and cost of a LiveCodeBench run; writes usage.md and
#                          # usage.json (prices per 1M tokens: --price-in/--price-hit/--price-out or PRICE_IN/PRICE_HIT/PRICE_OUT,
#                          # off-peak rates with --price-off-* or PRICE_OFF_*)
#   cb rejudge <run dir>   # re-judge a LiveCodeBench run: AtCoder answers with real stdin/stdout and checkers (LCB's judge
#                          # mocks stdin wrongly); writes <run dir>/rejudge.jsonl
#   cb perf <run dir>...   # CPU time and peak memory of the passing answers on the official tests (fresh process per run,
#                          # pinned cores); writes perf.md/perf.json in each run dir; several run dirs are measured together
#                          # and compared (ratio to the fastest answer)
#   cb quality <run dir>   # static code quality of a LiveCodeBench run (Pylint, Radon; add --sonar for SonarQube) with the
#                          # tables of arXiv:2610.19167; writes <run dir>/quality.jsonl and quality.md
#
# Ladder test set (L1-L4 USACO 2024-26 + EGOI/IOI 2026, L5 FrontierCS; samples/ladder.json):
#   cb ladder [--smoke] [--tiers L1,L2] [--only pid,...]   # generate, judge, time against the official solutions,
#                          # static quality (Python tiers), report; run dir runs/<model>/ladder-<full|smoke>
#   cb ladder-judge <run dir>     # (re-)judge a ladder run; cb ladder-report <run dir>... [--out dir] compares runs
#   cb ladder-data [--status]     # download the sources (resumable) / show progress; cb ladder-build [--calibrate]
#
# Optional: MAX_TOKENS (default 16384; must fit the model's context; "none" = send no limit, LiveCodeBench only), WORKERS (parallel requests, default 16),
#           LCB_RELEASE (default release_v6), LCB_START (only problems released on/after this date, e.g. 2025-01-01),
#           LCB_IDS (file of question_ids: run exactly those LiveCodeBench problems, e.g. samples/lcb_newest100.txt),
#           LCB_TIMEOUT (streamed: seconds without a new token before a request is retried, default 300; with STREAM=0:
#           seconds for the whole answer, default 1800),
#           LCB_OMIT (comma-separated request fields to leave out, for models that fix them, e.g. Kimi K3.1 Pro:
#           temperature,top_p,n,presence_penalty,frequency_penalty),
#           STREAM (default 1: LiveCodeBench and CRUXEval requests are streamed; 0 = one plain response per request;
#           BigCodeBench always uses its own client),
#           CRUX_MAX_TOKENS (CRUXEval's own limit is 100 direct / 1000 CoT; reasoning models count their thinking
#           in max_tokens, so set it, e.g. to $MAX_TOKENS).
# Model-generated code is executed, so everything runs as the unprivileged user "bench".
set -euo pipefail
CB=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)   # install dir = parent of bin/
KEEP=MODEL,OPENAI_BASE_URL,OPENAI_API_KEY,MAX_TOKENS,WORKERS,LADDER_N,LADDER_TIMEOUT,LADDER_OMIT,LADDER_LENIENT,LADDER_CORES,TEMPERATURE,RETRIES,LCB_RELEASE,LCB_START,LCB_IDS,LCB_TIMEOUT,LCB_OMIT,STREAM,LCB_STREAM,CB_POST,CRUX_MAX_TOKENS,PRICE_IN,PRICE_HIT,PRICE_OUT,PRICE_OFF_IN,PRICE_OFF_HIT,PRICE_OFF_OUT,PEAK_HOURS_UTC,SONAR_URL,SONAR_TOKEN,SONAR_SCANNER
if [ "$(id -un)" != bench ]; then exec sudo -u bench -H --preserve-env=$KEEP "$0" "$@"; fi
source $CB/env.sh
export PATH=$CB/.local/bin:$PATH MPLCONFIGDIR=$CB/.cache/matplotlib
cd $CB/runs   # harnesses chdir back to the start dir; root's cwd is unreadable for bench

summary() {
  python3 - "$CB/runs" <<'PY'
import glob, json, os, sys
rows = []
for f in sorted(glob.glob(os.path.join(sys.argv[1], "*", "*", "result.json"))):
    r = json.load(open(f))
    rj = os.path.join(os.path.dirname(f), "rejudge.jsonl")  # cb rejudge: the score to compare models with
    v = [json.loads(l)["passed"] for l in open(rj)] if os.path.exists(rj) else []
    rows.append((r["model"], r["benchmark"], r.get("pass@1"), round(100 * sum(v) / len(v), 2) if v else "-",
                 r.get("problems"), "full" if r.get("full_set") else "SMOKE/partial"))
if not rows:
    print("no finished runs yet"); sys.exit()
w, wb = max(len(r[0]) for r in rows), max(len(r[1]) for r in rows)
print(f"{'model':<{w}}  {'benchmark':<{wb}} {'pass@1':>7} {'rejudged':>8} {'n':>5}  set")
for m, b, p, rp, n, s in rows:
    print(f"{m:<{w}}  {b:<{wb}} {p if p is not None else '-':>7} {rp:>8} {n:>5}  {s}")
PY
}

post() {  # every evaluation also gets its re-judged score, latency and cost, static quality and code performance
  local d=$1 py=$CB/venvs/livecodebench/bin/python sonar=()
  [ -n "${SONAR_URL:-}" ] && sonar=(--sonar)
  echo "=== post-processing $d: rejudge, usage, quality${SONAR_URL:+ (SonarQube)}, perf  $(date +%T)"
  $py $CB/tools/lcb_rejudge.py "$d" | tail -3 || echo "=== rejudge FAILED" >&2
  $py $CB/tools/lcb_usage.py "$d" > /dev/null && sed -n 3,8p "$d/usage.md" || echo "=== usage FAILED" >&2
  SONAR_USER_HOME=$CB/.cache/sonar $CB/venvs/quality/bin/python $CB/tools/lcb_quality.py "$d" "${sonar[@]}" > /dev/null \
    && echo "quality: $d/quality.md" || echo "=== quality FAILED" >&2
  $py $CB/tools/lcb_perf.py "$d" > /dev/null && echo "perf: $d/perf.md" || echo "=== perf FAILED" >&2
  echo "=== post-processing done  $(date +%T)"
}

[ $# -ge 1 ] || { sed -n 2,44p "$0" | sed 's/^# \{0,1\}//'; exit 1; }
[ "$1" = summary ] && { summary; exit; }
LPY=$CB/venvs/livecodebench/bin/python   # Python 3.11 with openai, httpx, PyYAML; also the judge's Python for answers
ladder_post() {  # judge, performance, static quality, report of one ladder run
  local d=$1 sonar=()
  [ -n "${SONAR_URL:-}" ] && sonar=(--sonar)
  echo "=== judging $d  $(date +%T)"
  $LPY $CB/tools/ladder_judge.py "$d" || echo "=== judge FAILED" >&2
  SONAR_USER_HOME=$CB/.cache/sonar $CB/venvs/quality/bin/python $CB/tools/ladder_quality.py "$d" "${sonar[@]}" \
    || echo "=== quality FAILED" >&2
  $LPY $CB/tools/ladder_report.py "$d" --out "$d/report" || echo "=== report FAILED" >&2
  echo "=== ladder done  $(date +%T): $d/report/report.md"
}
case "$1" in
  ladder-data)
    L=$CB/data/ladder
    [ "${2:-}" = --status ] && { bash $CB/tools/ladder_download.sh --status $L/download.tsv $L/raw; exit; }
    pgrep -u bench -f "ladder_download.sh $L/download.tsv" >/dev/null && { echo "already downloading; cb ladder-data --status"; exit; }
    [ -f $L/download.tsv ] || zcat $CB/samples/ladder_download.tsv.gz > $L/download.tsv
    cd $L && nohup nice -n 10 bash $CB/tools/ladder_download.sh $L/download.tsv $L/raw "${2:-6}" >> $L/download.log 2>&1 &
    echo "downloading in the background (log $L/download.log); cb ladder-data --status"; exit ;;
  ladder-build) exec $LPY $CB/tools/ladder_build.py "${@:2}" ;;
  ladder-judge)
    [ -n "${2:-}" ] || { echo "usage: cb ladder-judge <run dir> [--workers N] [--perf-reps 3]" >&2; exit 1; }
    exec $LPY $CB/tools/ladder_judge.py "$(readlink -f "$2")" "${@:3}" ;;
  ladder-post)
    [ -n "${2:-}" ] || { echo "usage: cb ladder-post <run dir>" >&2; exit 1; }
    ladder_post "$(readlink -f "$2")"; exit ;;
  ladder-report)
    args=(); for x in "${@:2}"; do if [ -d "$x" ]; then args+=("$(readlink -f "$x")"); else args+=("$x"); fi; done
    exec $LPY $CB/tools/ladder_report.py "${args[@]}" ;;
  ladder)
    : "${MODEL:?set MODEL}" "${OPENAI_BASE_URL:?set OPENAI_BASE_URL}" "${OPENAI_API_KEY:?set OPENAI_API_KEY}"
    tag=full; extra=()
    for x in "${@:2}"; do [ "$x" = --smoke ] && tag=smoke; done
    d=$CB/runs/${MODEL//\//_}/ladder-$tag; mkdir -p "$d"
    echo "=== ladder ($tag) model=$MODEL  $(date +%F\ %T)"
    rc=0; LADDER_PYTHON=$LPY $LPY $CB/bin/ladder_run.py --out "$d" "${@:2}" || rc=$?   # 3 = out of balance
    [ $rc = 0 ] || [ $rc = 3 ] || { echo "=== ladder generation FAILED (exit $rc)" >&2; exit $rc; }
    [ "${CB_POST:-1}" = 0 ] || LADDER_PYTHON=$LPY ladder_post "$d"
    exit $rc ;;
esac
if [ "$1" = post ]; then
  [ -n "${2:-}" ] || { echo "usage: cb post <run dir>" >&2; exit 1; }
  post "$(readlink -f "$2")"; exit
fi
if [ "$1" = progress ]; then
  [ -n "${2:-}" ] || { echo "usage: cb progress <run dir> [--watch seconds] [--text]" >&2; exit 1; }
  exec $CB/venvs/livecodebench/bin/python $CB/tools/lcb_progress.py "$(readlink -f "$2")" "${@:3}"
fi
if [ "$1" = report ]; then
  [ -n "${2:-}" ] || { echo "usage: cb report <run dir>" >&2; exit 1; }
  exec $CB/venvs/livecodebench/bin/python $CB/tools/lcb_report.py "$(readlink -f "$2")" "${@:3}"
fi
if [ "$1" = usage ]; then
  [ -n "${2:-}" ] || { echo "usage: cb usage <run dir> [--price-in X --price-hit Y --price-out Z [--price-off-in ...]]" >&2; exit 1; }
  exec $CB/venvs/livecodebench/bin/python $CB/tools/lcb_usage.py "$(readlink -f "$2")" "${@:3}"
fi
if [ "$1" = rejudge ]; then
  [ -n "${2:-}" ] || { echo "usage: cb rejudge <run dir> [--workers N] [--timeout seconds per test]" >&2; exit 1; }
  exec $CB/venvs/livecodebench/bin/python $CB/tools/lcb_rejudge.py "$(readlink -f "$2")" "${@:3}"
fi
if [ "$1" = perf ]; then
  [ -n "${2:-}" ] || { echo "usage: cb perf <run dir> [<run dir> ...] [--reps 3] [--workers 6] [--out compare.md]" >&2; exit 1; }
  args=(); for x in "${@:2}"; do if [ -d "$x" ]; then args+=("$(readlink -f "$x")"); else args+=("$x"); fi; done
  exec $CB/venvs/livecodebench/bin/python $CB/tools/lcb_perf.py "${args[@]}"
fi
if [ "$1" = quality ]; then
  [ -n "${2:-}" ] || { echo "usage: cb quality <run dir> [--sonar] [--workers N]" >&2; exit 1; }
  export SONAR_USER_HOME=$CB/.cache/sonar   # the scanner's cache; bench can't write the install dir itself
  exec $CB/venvs/quality/bin/python $CB/tools/lcb_quality.py "$(readlink -f "$2")" "${@:3}"
fi
SMOKE=0; BENCHES=()
for a in "$@"; do
  case $a in
    --smoke) SMOKE=1 ;;
    all) BENCHES+=(bigcodebench livecodebench cruxeval) ;;
    bigcodebench|livecodebench|cruxeval) BENCHES+=("$a") ;;
    *) echo "unknown argument: $a" >&2; exit 1 ;;
  esac
done
: "${MODEL:?set MODEL}" "${OPENAI_BASE_URL:?set OPENAI_BASE_URL}" "${OPENAI_API_KEY:?set OPENAI_API_KEY}"
export OPENAI_KEY=$OPENAI_API_KEY   # LiveCodeBench reads OPENAI_KEY
if [ -n "${LCB_IDS:-}" ]; then   # a relative path is taken from the install dir, e.g. samples/lcb_newest100.txt
  [ "${LCB_IDS:0:1}" = / ] || LCB_IDS=$CB/$LCB_IDS
  [ -f "$LCB_IDS" ] || { echo "LCB_IDS: no such file $LCB_IDS" >&2; exit 1; }
  export LCB_IDS
fi
MAX_TOKENS=${MAX_TOKENS:-16384}; WORKERS=${WORKERS:-16}
TAG=$( [ $SMOKE = 1 ] && echo smoke || echo full )
SAFE=${MODEL//\//_}

result() {  # benchmark score problems full dir
  [ "${4:-0}" -gt 0 ] || { echo "no problems were scored (check the date filter / dataset)" >&2; return 1; }
  python3 -c 'import json,sys; b,m,s,n,f,d=sys.argv[1:]; json.dump({"benchmark":b,"model":m,"pass@1":round(float(s),2),"problems":int(n),"full_set":f=="1"}, open(d+"/result.json","w"), indent=1)' "$@"
}

run_bigcodebench() {
  local d=$CB/runs/$SAFE/bigcodebench-hard-$TAG; mkdir -p "$d"; cd "$d"
  local extra=()
  if [ $SMOKE = 1 ]; then
    local ids; ids=$($CB/venvs/bigcodebench/bin/python -c "
from bigcodebench.data import get_bigcodebench
print(','.join(list(get_bigcodebench(subset='hard'))[:5]))")
    extra=(--id_range 0-5 --selective_evaluate "$ids")
  fi
  $CB/venvs/bigcodebench/bin/bigcodebench.evaluate --model "$MODEL" --backend openai --base_url "$OPENAI_BASE_URL" \
    --split instruct --subset hard --execution local --greedy --max_new_tokens "$MAX_TOKENS" --parallel "$WORKERS" \
    --root "$d/bcb_results" --pass_k 1 "${extra[@]}" || return 1
  local f; f=$(ls "$d"/bcb_results/*_pass_at_k.json | head -1)
  local p1 n; read -r p1 n < <(python3 -c 'import json,sys; r=json.load(open(sys.argv[1])); e=json.load(open(sys.argv[1].replace("_pass_at_k.json","_eval_results.json"))); print(r["pass@1"]*100, len(e["eval"]))' "$f")
  result bigcodebench-hard-instruct "$MODEL" "$p1" "$n" $([ $SMOKE = 1 ] && echo 0 || echo 1) "$d"
}

run_livecodebench() {
  local d=$CB/runs/$SAFE/livecodebench${LCB_IDS:+-$(basename "$LCB_IDS" .txt)}-$TAG; mkdir -p "$d"; cd "$d"
  ln -sfn $CB/src/LiveCodeBench/lcb_runner lcb_runner   # it opens prompt files by relative path
  local lcb_max=$MAX_TOKENS; [ "$MAX_TOKENS" = none ] && lcb_max=0   # lcb_run.py then drops max_tokens from the request
  # On a resumed run LCB only grades problems missing from the old _eval_all.json, so an answer regenerated after
  # an empty one (e.g. with a larger MAX_TOKENS) would keep its old grade. Re-grade every saved answer instead:
  # generation still resumes (no repeated API calls), grading is local and takes seconds to minutes.
  rm -f "$d"/output/*/Scenario.codegeneration_*_eval.json "$d"/output/*/Scenario.codegeneration_*_eval_all.json
  export LCB_USAGE_LOG=$d/usage.jsonl   # per-call latency and tokens, read by tools/lcb_usage.py
  local timeout=${LCB_TIMEOUT:-300}   # streamed: the longest gap between two tokens
  [ "${STREAM:-${LCB_STREAM:-1}}" = 0 ] && timeout=${LCB_TIMEOUT:-1800}   # one response: the whole answer
  local extra=()
  [ -n "${LCB_START:-}" ] && extra+=(--start_date "$LCB_START")
  [ $SMOKE = 1 ] && extra=(--start_date 2025-04-01)   # a handful of the newest problems (release_v6 ends 2025-04-06)
  $CB/venvs/livecodebench/bin/python $CB/bin/lcb_run.py --scenario codegeneration \
    --release_version "${LCB_RELEASE:-release_v6}" --n 1 --temperature 0.2 --max_tokens "$lcb_max" \
    --openai_timeout "$timeout" --multiprocess "$WORKERS" --evaluate --num_process_evaluate "$WORKERS" \
    --continue_existing_with_eval "${extra[@]}" || return 1
  local f; f=$(ls "$d"/output/*/Scenario.codegeneration_1_0.2_eval.json | head -1)
  local p1 n; read -r p1 n < <(python3 -c 'import json,sys; r=json.load(open(sys.argv[1])); r=r[0] if isinstance(r,list) else r; print(r["pass@1"]*100 if r["pass@1"]<=1 else r["pass@1"], len(json.load(open(sys.argv[1].replace("_eval.json","_eval_all.json")))))' "$f")
  result "livecodebench-${LCB_RELEASE:-release_v6}${LCB_START:+-from-$LCB_START}${LCB_IDS:+-$(basename "$LCB_IDS" .txt)}" "$MODEL" "$p1" "$n" $([ $SMOKE = 1 ] && echo 0 || echo 1) "$d" || return 1
  [ "${CB_POST:-1}" = 0 ] || post "$d"
}

run_cruxeval() {
  local lim=(); [ $SMOKE = 1 ] && lim=(--limit 5)
  [ -n "${CRUX_MAX_TOKENS:-}" ] && lim+=(--max_tokens "$CRUX_MAX_TOKENS")
  for mode in input output; do
    local d=$CB/runs/$SAFE/cruxeval-$mode-$TAG; mkdir -p "$d"; cd "$d"
    $CB/venvs/cruxeval/bin/python $CB/bin/crux_run.py --mode $mode --n 1 --temperature 0.2 --workers "$WORKERS" \
      --out "$d" "${lim[@]}" || return 1
  done
}

for b in "${BENCHES[@]}"; do
  echo "=== $b ($TAG) model=$MODEL  $(date +%F\ %T)"
  if "run_$b"; then echo "=== $b done"; else echo "=== $b FAILED (exit $?)" >&2; fi
done
summary
